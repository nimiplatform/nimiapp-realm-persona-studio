{
  "name": "nimiapp-realm-persona-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "nimi-app dev --shell electron",
    "dev:renderer": "vite --host 127.0.0.1 --port 1450 --strictPort",
    "dev:shell": "nimi-app dev",
    "dev:electron": "nimi-app dev --shell electron",
    "build:renderer": "vite build",
    "build:electron": "tsc -p tsconfig.electron.json && node scripts/bundle-electron-preload.mjs",
    "typecheck": "pnpm run typecheck:renderer && pnpm run typecheck:electron",
    "typecheck:renderer": "tsc --noEmit",
    "typecheck:electron": "tsc -p tsconfig.electron.json --noEmit",
    "build": "pnpm run typecheck && pnpm run build:renderer && pnpm run build:electron",
    "lint": "pnpm run typecheck && eslint . --max-warnings 0",
    "spec:authority:check": "pnpm exec nimicoding authority check .nimi/spec",
    "spec:authority:compile": "pnpm exec nimicoding authority compile .nimi/spec",
    "check:spec-consistency": "pnpm run spec:authority:check",
    "i18n:check": "vitest run src/shell/renderer/i18n/studio-i18n.test.ts",
    "i18n:audit": "node scripts/i18n-audit.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate": "nimi-app check",
    "pack": "nimi-app pack",
    "check": "pnpm run validate && pnpm run check:spec-consistency && pnpm run i18n:check && pnpm run i18n:audit && pnpm run typecheck && pnpm run lint && pnpm run test",
    "nimicoding": "pnpm exec nimicoding",
    "nimicoding:doctor": "pnpm exec nimicoding doctor",
    "sync": "nimi-app sync",
    "postinstall": "install-electron",
    "build:electron:production": "node scripts/clean-electron-production.mjs && pnpm run build && node scripts/package-electron-production.mjs"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "electron": "^42.5.0",
    "esbuild": "^0.28.0",
    "eslint": "^10.4.0",
    "globals": "^17.6.0",
    "jsdom": "^28.1.0",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.20.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.59.4",
    "vite": "^7.3.6",
    "vitest": "^4.1.7",
    "yaml": "^2.9.0",
    "@nimiplatform/app-tools": "^0.2.9",
    "@nimiplatform/nimi-coding": "0.6.1"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.100.11",
    "i18next": "^25.8.18",
    "lucide-react": "^0.577.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-i18next": "^16.5.8",
    "react-router-dom": "^7.15.1",
    "scheduler": "^0.27.0",
    "zustand": "^5.0.13",
    "@nimiplatform/sdk": "^0.9.1",
    "@nimiplatform/kit": "^0.5.1"
  },
  "main": "dist-electron/main.js",
  "author": "Nimi Team"
}
