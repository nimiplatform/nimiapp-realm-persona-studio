{
  "name": "nimiapp-realm-persona-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "nimi-app dev --shell electron",
    "dev:renderer": "vite --host 127.0.0.1 --port 1450 --strictPort",
    "dev:shell": "nimi-app dev",
    "dev:electron": "nimi-app dev --shell electron",
    "tauri": "tauri",
    "prepare:workspace-surfaces": "node ../../nimi/scripts/with-workspace-surfaces.mjs -- node --version",
    "build:renderer": "vite build",
    "build:electron": "tsc -p tsconfig.electron.json && node scripts/bundle-electron-preload.mjs",
    "typecheck": "pnpm run prepare:workspace-surfaces && pnpm run typecheck:renderer && pnpm run typecheck:electron",
    "typecheck:renderer": "tsc --noEmit",
    "typecheck:electron": "tsc -p tsconfig.electron.json --noEmit",
    "build": "pnpm run typecheck && pnpm run build:renderer && (cd src-tauri && cargo check)",
    "lint": "pnpm run typecheck && eslint . --max-warnings 0 && (cd src-tauri && cargo check)",
    "spec:authority:check": "pnpm exec nimicoding authority check .nimi/spec",
    "spec:authority:compile": "pnpm exec nimicoding authority compile .nimi/spec",
    "check:spec-consistency": "pnpm run spec:authority:check",
    "i18n:check": "vitest run src/shell/renderer/i18n/studio-i18n.test.ts",
    "i18n:audit": "node scripts/i18n-audit.mjs",
    "check:phase1-closeout": "pnpm run check:spec-consistency && pnpm run typecheck && pnpm run test && pnpm run lint && cargo test --manifest-path src-tauri/Cargo.toml",
    "test": "pnpm run prepare:workspace-surfaces && vitest run",
    "test:watch": "vitest",
    "validate": "node scripts/validate.mjs",
    "local-audit": "node scripts/local-audit.mjs",
    "pack": "pnpm run build:renderer && node scripts/pack.mjs",
    "doctor": "nimi-app doctor",
    "check": "pnpm run doctor && pnpm run validate && pnpm run local-audit && pnpm run check:spec-consistency && pnpm run i18n:check && pnpm run i18n:audit && pnpm run typecheck && pnpm run lint && pnpm run test",
    "nimicoding": "pnpm exec nimicoding",
    "nimicoding:doctor": "pnpm exec nimicoding doctor"
  },
  "devDependencies": {
    "@nimiplatform/app-tools": "link:../../nimi/app-tools",
    "@eslint/js": "^10.0.1",
    "@nimiplatform/nimi-coding": "0.6.1",
    "@tailwindcss/vite": "^4.3.0",
    "@tauri-apps/cli": "^2.11.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "electron": "^42.5.0",
    "esbuild": "^0.28.0",
    "eslint": "^10.4.0",
    "globals": "^17.6.0",
    "jsdom": "^28.1.0",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.20.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.59.4",
    "vite": "^7.3.1",
    "vitest": "^4.1.7",
    "yaml": "^2.9.0"
  },
  "dependencies": {
    "@nimiplatform/kit": "link:../../nimi/kit",
    "@nimiplatform/sdk": "link:../../nimi/sdks/typescript",
    "@tanstack/react-query": "^5.100.11",
    "@tauri-apps/api": "^2.11.0",
    "i18next": "^25.8.18",
    "lucide-react": "^0.577.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-i18next": "^16.5.8",
    "react-router-dom": "^7.15.1",
    "scheduler": "^0.27.0",
    "zustand": "^5.0.13"
  }
}
